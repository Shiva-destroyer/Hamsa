# ---------- copy to .env (never commit .env). Placeholder values only. ----------
# Local-dev Postgres (docker compose up -d db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hamsa

# Meta WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WA_ACCESS_TOKEN=EAAxxxxxxxx            # temporary token (24 h); use a System-User token (never expires) for a long-running deployment
WA_PHONE_NUMBER_ID=123456789012345     # the ID under the "From" dropdown. NOT the phone number itself
WA_APP_SECRET=0123456789abcdef0123456789abcdef   # App settings -> Basic -> App secret (signs every webhook POST)
WA_VERIFY_TOKEN=change-me-random-string          # you invent this; paste the same string in Meta's webhook form
WA_APP_ID=123456789012345              # only used by scripts/set_webhook.py
WA_GRAPH_VERSION=v24.0                 # check the version shown in Meta's own curl sample and match it

# Hamsa
IDENTITY_SECRET=change-me-another-random-string  # HMAC key: phone number -> irreversible identity hash
JWT_SECRET=change-me-a-third-random-string       # signs regulator API tokens
REGULATOR_USERNAME=regulator                     # regulator API login
REGULATOR_SHARED_SECRET=change-me-regulator-secret
PUBLIC_BASE_URL=https://something.trycloudflare.com   # printed by cloudflared; update each time it restarts
DRY_RUN=0            # 1 = never call Meta; print outbound messages to the console (safe local dev)
ENABLE_SCHEDULER=0   # 1 = run the retention background jobs in-process
SLA_DAYS=7           # dispute response SLA in days
# optional: a real NSQ batch number that rehearse.py / preflight.py should use for the "official record" check
DEMO_REAL_BATCH=
UPLOAD_DIR=api/uploads
DEV_DOCS=0           # 1 = expose /docs and /openapi.json (leave 0 in production)
FLORENCE=1            # 1 = Florence-2 reads photo text first (needs torch+transformers, ~470 MB download on first run); 0 = Tesseract only
# FLORENCE_MODEL=florence-community/Florence-2-base-ft   # microsoft/Florence-2-base-ft in transformers' native layout
